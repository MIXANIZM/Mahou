+
+                IntPtr textLengthResult;
+                if (SendMessageTimeout(info.hwndFocus, WM_GETTEXTLENGTH, IntPtr.Zero, IntPtr.Zero,
+                                       SMTO_ABORTIFHUNG, 40, out textLengthResult) == IntPtr.Zero)
+                    return false;
+                var textLength = textLengthResult.ToInt32();
